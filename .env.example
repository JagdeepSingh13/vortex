# Copy to .env and fill in (`make up` does this on first run). .env is gitignored; never commit real values.
# Variables are added here by the milestone that first needs them.

COMPOSE_PROJECT_NAME=vortex

# M6: credentials of the local S3-compatible store (SeaweedFS). Local only, but still kept out of git.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
